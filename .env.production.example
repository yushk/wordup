# WordUp 生产环境配置模板
# 复制为 .env 并填入真实值（.env 不进 git）

# PostgreSQL 密码（自行生成强密码，如 openssl rand -base64 24）
POSTGRES_PASSWORD=change-me-to-a-strong-password

# JWT 签名密钥（自行生成，如 openssl rand -base64 48）
JWT_SECRET=change-me-to-a-random-secret

# 管理员账号：首次启动自动创建（已存在则跳过），可登录管理后台 /admin
ADMIN_EMAIL=admin@wordup.xin
ADMIN_PASSWORD=change-me-too

# 阿里云邮件 SMTP（找回密码验证码用；不配置则该功能返回「邮件服务未配置」）
# 阿里云邮件推送控制台：https://dm.console.aliyun.com → 发信地址 → 开启 SMTP
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=no-reply@mail.wordup.xin
SMTP_PASS=your-smtp-password
# 发件人显示（可选）
SMTP_FROM=WordUp <no-reply@mail.wordup.xin>
